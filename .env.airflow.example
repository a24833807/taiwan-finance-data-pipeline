# Airflow local learning environment only.
AIRFLOW_IMAGE_NAME=taiwan-finance-airflow:3.2.0
AIRFLOW_UID=50000

AIRFLOW_METADATA_DB_NAME=airflow
AIRFLOW_METADATA_DB_USER=airflow
AIRFLOW_METADATA_DB_PASSWORD=airflow

AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# Replace these example values before using the environment beyond local learning.
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=airflow_jwt_secret_for_local_learning

# Existing ETL PostgreSQL connection from inside the Airflow containers.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=finance_db
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_password
